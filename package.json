{
  "name": "wardlens-civic-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A civic participation and public project accountability PWA for communities and county governments.",
  "scripts": {
    "dev": "node scripts/dev.js",
    "api": "node server/index.js",
    "db:import:turso": "node server/import-sqlite-to-turso.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "pwa": "npm run build && vite preview --host 0.0.0.0 --port 4173",
    "test": "node --test tests/*.test.js",
    "dev:web": "vite --host 0.0.0.0"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
